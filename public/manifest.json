{
  "manifest_version": 3,
  "name": "Screen Time",
  "version": "0.2.3",
  "description": "Track a shared daily allowance across selected sites and their child tabs.",
  "permissions": ["storage", "alarms", "webNavigation", "sessions"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Screen Time",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/inactive.svg"
    }
  },
  "icons": {
    "48": "icons/active.svg",
    "96": "icons/active.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-screen-time@example.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
